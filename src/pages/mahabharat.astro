---
import Layout from '../layouts/Layout.astro';
import StoryDisplay from '../components/StoryDisplay.tsx';
---

<Layout title="Tales of the Mahabharat - Krishna GPT">
  <div class="flex flex-col" style="height: 100dvh; max-width: 860px; margin: 0 auto; padding: 0 24px 96px;">

    <div class="pt-12 pb-6 text-center flex-shrink-0">
      <p class="text-white/20 text-[10px] font-bold tracking-[0.3em] uppercase mb-3">The Great Epic</p>
      <h1 class="text-3xl font-serif text-white tracking-tight" style="letter-spacing: -0.02em;">Mahabharat Tales</h1>
      <p class="text-white/20 text-sm mt-2" style="max-width: 360px; margin-left: auto; margin-right: auto;">Stories of valor, dharma, and the eternal struggle between right and wrong.</p>
    </div>

    <div class="flex-1 min-h-0">
      <StoryDisplay client:load />
    </div>

  </div>
</Layout>
